<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pie de página Babatsa. Reemplaza el contenido del pie "Default" de Odoo.
        La línea de copyright de Odoo se mantiene debajo y se edita desde el constructor:
        escribir "© Babatsa. Todos los derechos reservados."
        "Ver vacantes" apunta a /jobs (app Reclutamiento: RH publica y el candidato adjunta su CV).
    -->
    <template id="bbt_footer" inherit_id="website.footer_custom" name="Babatsa: Pie de página">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                <section class="bbt bbt-footer-wrap">
              <!-- ===================== PIE DE PÁGINA ===================== -->
              <div class="bbt-footer">
                <div class="container">
                  <div class="row g-4">
                    <div class="col-lg-4">
                      <img class="bbt-flogo" src="/website_babatsa/static/src/img/logo-blanco.svg" alt="Babatsa"/>
                      <img class="bbt-fvct" src="/website_babatsa/static/src/img/vamos-con-todo-blanco.svg" alt="Vamos con todo"/>
                    </div>
                    <div class="col-6 col-lg-2">
                      <h4>Enlaces</h4>
                      <ul>
                        <li><a href="/">Inicio</a></li><li><a href="/nosotros">Nosotros</a></li><li><a href="/productos">Productos</a></li>
                        <li><a href="/marcas">Marcas</a></li><li><a href="/servicios">Servicios</a></li><li><a href="/sucursales">Sucursales</a></li><li><a href="/contacto">Contacto</a></li>
                      </ul>
                    </div>
                    <div class="col-6 col-lg-3">
                      <h4>CEDIS Poseidón</h4>
                      <ul>
                        <li>[Dirección del CEDIS]</li>
                        <li><a href="tel:+520000000000">[Teléfono general]</a></li>
                        <li><a href="mailto:contacto@babatsa.com.mx">[Correo general]</a></li>
                      </ul>
                    </div>
                    <div class="col-lg-3">
                      <h4>Síguenos</h4>
                      <div class="bbt-social">
                        <a href="#" aria-label="Facebook Babatsa Los Mochis"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8z"/></svg></a>
                        <a href="#" aria-label="Instagram Babatsa"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>
                        <a href="#" aria-label="LinkedIn Babatsa"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 9h4v12H4zM6 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h4v2c.6-1.2 2-2.2 4-2.2 3.4 0 4 2.2 4 5V21h-4v-6c0-1.5 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H10z"/></svg></a>
                      </div>
                      <h4 style="margin-top:28px !important">Trabaja con nosotros</h4>
                      <a class="bbt-jobs" href="/jobs">Ver vacantes →</a>
                    </div>
                  </div>
                  <div class="bbt-fbottom">
                    <span>Babatsa · Vamos con todo</span>
                    <a href="/aviso-de-privacidad">Aviso de privacidad</a>
                  </div>
                </div>
              </div>

                </section>
            </div>
        </xpath>
    </template>
</odoo>
