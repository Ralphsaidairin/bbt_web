<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Página de inicio Babatsa.
        Las marcas se leen de Sitio web > Configuración > Marcas Babatsa (no se editan aquí).
        Importante: si la página de inicio ya fue editada antes en el constructor, Odoo guarda
        una copia específica del sitio y esta herencia no se verá. En ese caso: modo desarrollador >
        Sitio web > Páginas > Inicio > restablecer la vista, o borrar la copia específica del sitio.
    -->
    <template id="bbt_homepage" inherit_id="website.homepage" name="Babatsa: Inicio">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap">
                <div class="oe_structure" id="oe_structure_bbt_home_top">

        <!-- ===================== BANNER / CARRUSEL (editable) ===================== -->
        <section class="bbt bbt-hero">
          <div id="bbtHero" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#bbtHero" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Mensaje institucional"></button>
              <button type="button" data-bs-target="#bbtHero" data-bs-slide-to="1" aria-label="Aniversario"></button>
              <button type="button" data-bs-target="#bbtHero" data-bs-slide-to="2" aria-label="Promoción"></button>
            </div>
            <div class="carousel-inner">

              <!-- Slide 1 · Mensaje institucional -->
              <div class="carousel-item active bbt-slide bbt-slide--brand">
                <div class="container">
                  <div class="row align-items-center">
                    <div class="col-lg-7">
                      <img class="bbt-vct" src="/website_babatsa/static/src/img/vamos-con-todo-blanco.svg" alt="Vamos con todo"/>
                      <h1>Más que <span>ferretería</span></h1>
                      <p class="bbt-sub">Soluciones para industria, agricultura, automotriz, mantenimiento y ferretería general.</p>
                      <div class="bbt-ctas">
                        <a class="bbt-btn bbt-btn--yellow" href="/productos">Ver productos</a>
                        <a class="bbt-btn bbt-btn--ghost-light" href="/sucursales">Encuentra tu sucursal</a>
                      </div>
                    </div>
                    <div class="col-lg-5">
                      <div class="bbt-photo"><img src="/website_babatsa/static/src/img/ph/mostrador.svg" alt="Equipo de Babatsa atendiendo en mostrador"/></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Slide 2 · Aniversario (cambiar o quitar cuando termine la campaña) -->
              <div class="carousel-item bbt-slide bbt-slide--aniv">
                <div class="container">
                  <div class="row align-items-center">
                    <div class="col-lg-6">
                      <div class="bbt-aniv-year">1968</div>
                      <h1 style="margin-top:1rem">Manteniendo en movimiento <span>al noroeste</span></h1>
                      <p class="bbt-sub">Más de cinco décadas creciendo junto al campo, la industria, los talleres y los negocios de nuestros clientes.</p>
                      <div class="bbt-ctas">
                        <a class="bbt-btn bbt-btn--yellow" href="/nosotros">Conoce nuestra historia</a>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="bbt-photo" style="transform:rotate(-1.5deg)"><img src="/website_babatsa/static/src/img/ph/aniversario.svg" alt="Logo de aniversario Babatsa"/></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Slide 3 · Promoción vigente -->
              <div class="carousel-item bbt-slide bbt-slide--promo">
                <div class="container">
                  <div class="row align-items-center">
                    <div class="col-lg-6">
                      <span class="bbt-tag">Promoción del mes</span>
                      <h1>[Nombre de la <span>promoción</span>]</h1>
                      <p class="bbt-sub">[Descripción breve, vigencia y sucursales participantes.]</p>
                      <div class="bbt-ctas">
                        <a class="bbt-btn bbt-btn--blue" href="/sucursales">Pregunta en tu sucursal</a>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="bbt-photo"><img src="/website_babatsa/static/src/img/ph/promo.svg" alt="Producto en promoción"/></div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#bbtHero" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Anterior</span></button>
            <button class="carousel-control-next" type="button" data-bs-target="#bbtHero" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Siguiente</span></button>
          </div>
        </section>

        <!-- ===================== CATEGORÍAS Y SECTORES (cuadrícula de íconos) =====================
             Íconos provisionales en colores de marca; cambiarlos por los de la agencia cuando lleguen. -->
        <section class="bbt bbt-apps">
          <div class="container">
            <p class="bbt-eyebrow">Productos</p>
            <h2 class="bbt-h2">Categorías de <em>productos</em></h2>
            <div class="bbt-apps-grid">
              <t t-call="website_babatsa.category_tiles"/>
            </div>

            <p class="bbt-eyebrow bbt-apps-sub">Sectores que atendemos</p>
            <div class="bbt-apps-grid">
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="35" cy="13" r="7" fill="#FFBE06"/><path d="M24 42V22" stroke="#002475" stroke-width="4" stroke-linecap="round"/><path d="M24 26C14 26 8 20 8 12c10 0 16 6 16 14z" fill="#0847E9"/><path d="M24 32c0-8 6-12 14-12 0 8-6 12-14 12z" fill="#002475"/></svg></span>
                <span class="bbt-app-name">Agrícola</span>
              </a>
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="31" y="6" width="7" height="20" fill="#0847E9"/><path d="M5 42V22l11 7v-7l11 7v-7l16 9v18z" fill="#002475"/><g fill="#FFBE06"><rect x="11" y="33" width="5" height="5"/><rect x="21" y="33" width="5" height="5"/><rect x="31" y="33" width="5" height="5"/></g></svg></span>
                <span class="bbt-app-name">Industrial</span>
              </a>
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 26l5-11h22l5 11z" fill="#0847E9"/><rect x="5" y="25" width="38" height="11" rx="4" fill="#002475"/><circle cx="13" cy="31" r="3" fill="#FFBE06"/><circle cx="35" cy="31" r="3" fill="#FFBE06"/><rect x="8" y="35" width="7" height="6" rx="2" fill="#002475"/><rect x="33" y="35" width="7" height="6" rx="2" fill="#002475"/></svg></span>
                <span class="bbt-app-name">Taller y mantenimiento</span>
              </a>
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="3" y="11" width="27" height="22" rx="2" fill="#0847E9"/><path d="M30 18h8l7 8v7H30z" fill="#002475"/><path d="M33 21h4l4 5h-8z" fill="#fff"/><circle cx="12" cy="36" r="5" fill="#FFBE06"/><circle cx="37" cy="36" r="5" fill="#FFBE06"/></svg></span>
                <span class="bbt-app-name">Transporte y flotillas</span>
              </a>
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M20 6h8l9 32H11z" fill="#FFBE06"/><path d="M17.2 16h13.6l1.7 6H15.5zM14.4 26h19.2l1.7 6H12.7z" fill="#002475"/><rect x="6" y="37" width="36" height="6" rx="3" fill="#0847E9"/></svg></span>
                <span class="bbt-app-name">Construcción</span>
              </a>
              <a class="bbt-app" href="/productos#sectores">
                <span class="bbt-app-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="22" width="32" height="20" fill="#002475"/><rect x="20" y="29" width="8" height="13" fill="#FFBE06"/><path d="M5 9h38l2 11a5 5 0 0 1-9.5 1.5A5 5 0 0 1 26 21.5a5 5 0 0 1-9.5 0A5 5 0 0 1 3 20z" fill="#0847E9"/><path d="M16.5 9h7.5v12.5a5 5 0 0 1-7.5 0zM31.5 9H24v12.5a5 5 0 0 0 7.5 0z" fill="#FFBE06"/></svg></span>
                <span class="bbt-app-name">Comercio y servicios</span>
              </a>
            </div>

            <div class="bbt-apps-foot">
              <a class="bbt-link" href="/productos">Conoce todas nuestras líneas <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>

                </div>
                <t t-call="website_babatsa.brand_home_section"/>
                <div class="oe_structure" id="oe_structure_bbt_home_bottom">

        <!-- ===================== SERVICIOS ===================== -->
        <section class="bbt bbt-sec">
          <div class="container">
            <div class="bbt-serv-grid">
              <div class="bbt-serv-photo">
                <img src="/website_babatsa/static/src/img/ph/asesor.svg" alt="Asesor de Babatsa con un cliente"/>
                <p class="bbt-serv-quote">No solo surtimos lo que necesitas. Te ayudamos a encontrar la mejor solución.</p>
              </div>
              <div>
                <p class="bbt-eyebrow">Servicios</p>
                <h2 class="bbt-h2">Soluciones que van <em>más allá del producto</em></h2>
                <p class="bbt-lead" style="margin-top:1rem">Personal capacitado y el respaldo de nuestras marcas para analizar tus necesidades, recomendar soluciones y dar soporte a tus equipos.</p>
                <div class="bbt-serv-list">
                  <div class="bbt-serv"><span class="bbt-n">01</span><h3>Asesoría especializada</h3><p>Te orientamos en la selección del producto según tu aplicación, antes y después de la compra.</p></div>
                  <div class="bbt-serv"><span class="bbt-n">02</span><h3>Centros de servicio</h3><p>Diagnóstico, mantenimiento y reparación de equipos de las marcas participantes.</p></div>
                  <div class="bbt-serv"><span class="bbt-n">03</span><h3>Análisis y proyectos de mejora</h3><p>Analizamos, identificamos, proponemos y damos seguimiento, con programas junto a marcas líderes.</p></div>
                  <div class="bbt-serv"><span class="bbt-n">04</span><h3>Garantías y respaldo de marcas</h3><p>Orientación y seguimiento de garantías según las políticas de cada fabricante.</p></div>
                </div>
                <div style="margin-top:28px"><a class="bbt-btn bbt-btn--blue" href="/servicios">Conoce nuestros servicios</a></div>
              </div>
            </div>
          </div>
        </section>

        <!-- ===================== SUCURSALES ===================== -->
        <section class="bbt bbt-sec bbt-branches">
          <div class="container">
            <div class="row align-items-center g-4">
              <div class="col-lg-5">
                <p class="bbt-eyebrow">Sucursales</p>
                <h2 class="bbt-h2">Cerca de ti, <em>donde lo necesitas</em></h2>
                <p class="bbt-lead" style="margin-top:1rem">Nuestra red de sucursales y Centro de Distribución nos permite atender clientes locales y foráneos.</p>
                <div class="bbt-stats">
                  <div class="bbt-stat"><strong>1968</strong><span>Desde</span></div>
                  <div class="bbt-stat"><strong>11</strong><span>Sucursales</span></div>
                  <div class="bbt-stat"><strong>1</strong><span>Centro de Distribución</span></div>
                </div>
                <p class="bbt-routes"><b>→</b> Atención más allá de nuestras sucursales: pregunta por nuestras rutas.</p>
                <div class="bbt-ctas">
                  <a class="bbt-btn bbt-btn--yellow" href="/sucursales">Encuentra tu sucursal</a>
                  <a class="bbt-btn bbt-btn--ghost-light" href="/contacto">Contáctanos</a>
                </div>
              </div>
              <div class="col-lg-7">
                <div class="bbt-map"><img src="/website_babatsa/static/src/img/ph/mapa.svg" alt="Mapa de sucursales Babatsa en el noroeste de México"/></div>
              </div>
            </div>
          </div>
        </section>

                </div>
            </div>
        </xpath>
    </template>
</odoo>
