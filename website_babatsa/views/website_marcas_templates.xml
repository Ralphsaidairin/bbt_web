<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mosaico de una marca: logo si existe, si no el nombre en tipografía de marca -->
    <template id="brand_tile" name="Babatsa: Mosaico de marca">
        <a t-if="b['url']" t-att-href="b['url']" target="_blank" rel="noopener" t-att-class="tile_class" t-att-title="b['name']">
            <t t-call="website_babatsa.brand_tile_inner"/>
        </a>
        <div t-else="" t-att-class="tile_class" t-att-title="b['name']">
            <t t-call="website_babatsa.brand_tile_inner"/>
        </div>
    </template>

    <template id="brand_tile_inner" name="Babatsa: Contenido de mosaico de marca">
        <img t-if="b['logo_url']" t-att-src="b['logo_url']" t-att-alt="b['name']" loading="lazy"/>
        <span t-else="" class="bbt-brand-name" t-esc="b['name']"/>
    </template>

    <!-- Sección dinámica para la página de inicio (fuera de oe_structure: se actualiza sola) -->
    <template id="brand_home_section" name="Babatsa: Marcas en inicio">
        <t t-set="home_brands" t-value="request.env['babatsa.brand'].sudo().search([('website_published', '=', True), ('tier', '=', 'principal')], limit=12)"/>
        <section t-if="home_brands" class="bbt bbt-sec bbt-brands-sec">
            <div class="container">
                <div class="bbt-head">
                    <div>
                        <p class="bbt-eyebrow">Marcas destacadas</p>
                        <h2 class="bbt-h2">Distribuidores de <em>grandes marcas</em></h2>
                    </div>
                    <p class="bbt-lead">Productos originales, calidad comprobada y el respaldo de fabricantes reconocidos.</p>
                </div>
                <div class="bbt-brands">
                    <t t-foreach="home_brands" t-as="brand">
                        <t t-set="b" t-value="brand._bbt_website_card()"/>
                        <t t-set="tile_class" t-value="'bbt-brand'"/>
                        <t t-call="website_babatsa.brand_tile"/>
                    </t>
                </div>
                <div class="bbt-brands-note">
                    <p>Además contamos con una amplia variedad de marcas especializadas para cada aplicación.</p>
                    <a class="bbt-btn bbt-btn--ghost" href="/marcas">Ver todas las marcas</a>
                </div>
            </div>
        </section>
    </template>

    <!-- Página /marcas -->
    <template id="marcas_page" name="Babatsa: Marcas">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'marcas'"/>
            <t t-set="additional_title">Marcas</t>
            <div id="wrap">
                <section class="bbt bbt-sec bbt-brands-hero">
                    <div class="container">
                        <p class="bbt-eyebrow">Nuestras marcas</p>
                        <h1 class="bbt-h2">Distribuidores de <em>grandes marcas</em></h1>
                        <p class="bbt-lead mt-3">En Babatsa trabajamos con marcas líderes y fabricantes reconocidos para ofrecer productos originales, calidad comprobada y el respaldo que nuestros clientes necesitan. Como distribuidores autorizados de grandes marcas, acercamos soluciones confiables para diferentes aplicaciones y sectores.</p>
                        <ul class="bbt-pillars">
                            <li>
                                <span class="bbt-cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
                                <h3>Productos originales</h3>
                                <p>Confianza en el origen y autenticidad de los productos.</p>
                            </li>
                            <li>
                                <span class="bbt-cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg></span>
                                <h3>Marcas reconocidas</h3>
                                <p>Fabricantes líderes para diferentes aplicaciones y necesidades.</p>
                            </li>
                            <li>
                                <span class="bbt-cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 13.8 7 21l5-3 5 3-1.5-7.2"/></svg></span>
                                <h3>Calidad y confiabilidad</h3>
                                <p>Productos seleccionados para responder a las exigencias de cada trabajo.</p>
                            </li>
                            <li>
                                <span class="bbt-cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11l3-3a2.5 2.5 0 0 1 3.5 0L18 12.5"/><path d="M3 13l4-4 4 4-4 4zM21 13l-4-4"/><path d="M11 17l2 2 6-6"/></svg></span>
                                <h3>Respaldo especializado</h3>
                                <p>Acompañamiento de Babatsa y, en líneas participantes, soporte y programas especializados de las marcas.</p>
                            </li>
                        </ul>
                    </div>
                </section>

                <section class="bbt bbt-sec bbt-brands-sec">
                    <div class="container">
                        <nav t-if="lines" class="bbt-city-nav" aria-label="Filtrar por línea de producto">
                            <a href="/marcas" t-att-class="'bbt-on' if not current_line else None">Todas</a>
                            <t t-foreach="lines" t-as="l">
                                <a t-att-href="'/marcas?linea=%s' % l['code']" t-att-class="'bbt-on' if l['code'] == current_line else None" t-esc="l['name']"/>
                            </t>
                        </nav>

                        <t t-if="principales">
                            <h2 class="bbt-city-title">Marcas principales<t t-if="current_line_name"> · <t t-esc="current_line_name"/></t></h2>
                            <div class="bbt-brands bbt-brands--main">
                                <t t-foreach="principales" t-as="b">
                                    <t t-set="tile_class" t-value="'bbt-brand bbt-brand--main'"/>
                                    <t t-call="website_babatsa.brand_tile"/>
                                </t>
                            </div>
                        </t>

                        <t t-if="especializadas">
                            <h2 class="bbt-city-title bbt-mt">Marcas especializadas<t t-if="current_line_name and not principales"> · <t t-esc="current_line_name"/></t></h2>
                            <div class="bbt-brands">
                                <t t-foreach="especializadas" t-as="b">
                                    <t t-set="tile_class" t-value="'bbt-brand'"/>
                                    <t t-call="website_babatsa.brand_tile"/>
                                </t>
                            </div>
                        </t>

                        <div t-if="not principales and not especializadas" class="bbt-empty">
                            No hay marcas publicadas en esta línea todavía. <a href="/marcas">Ver todas las marcas</a>.
                        </div>
                    </div>
                </section>

                <div class="oe_structure" id="oe_structure_bbt_marcas_mid"/>

                <section class="bbt bbt-sec bbt-brands-cta">
                    <div class="container">
                        <div class="bbt-cta-box">
                            <div>
                                <h2 class="bbt-h2">¿Buscas una marca que <em>no ves aquí?</em></h2>
                                <p class="bbt-lead mt-2">Pregúntanos. Manejamos muchas más marcas en sucursal y te conseguimos equivalencias.</p>
                            </div>
                            <a class="bbt-btn bbt-btn--yellow" href="/contacto?motivo=Información%20de%20producto">Pregunta por una marca</a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure" id="oe_structure_bbt_marcas_bottom"/>
            </div>
        </t>
    </template>
</odoo>
