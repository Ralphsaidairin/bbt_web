                                    <g data-part="sellos"><rect x="426" y="216" width="14" height="52" rx="3" class="eq-rubber"/><rect x="430" y="226" width="6" height="32" class="eq-yellow"/></g>
                                    <g data-part="pernos"><circle cx="78" cy="242" r="26" class="eq-metal"/><circle cx="78" cy="242" r="10" class="eq-navy"/><circle cx="604" cy="242" r="24" class="eq-metal"/><circle cx="604" cy="242" r="9" class="eq-navy"/>
                                        <rect x="92" y="226" width="24" height="32" class="eq-metal"/></g>
                                    <t t-foreach="[(1, 'manguera', 'Mangueras', 300, 88), (2, 'conexiones', 'Conexiones', 150, 176), (3, 'sellos', 'Sellos del cilindro', 433, 300), (4, 'aceite', 'Aceite hidráulico', 584, 128), (5, 'filtro', 'Filtro', 380, 72), (6, 'pernos', 'Pernos y pasadores', 78, 296)]" t-as="h">
                                        <t t-call="website_babatsa.tu_equipo_hot"><t t-set="n" t-value="h[0]"/><t t-set="key" t-value="h[1]"/><t t-set="name" t-value="h[2]"/><t t-set="x" t-value="h[3]"/><t t-set="y" t-value="h[4]"/></t>
                                    </t>
                                </svg>
                            </div>
                            <ol class="bbt-eq-list">
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="1"/><t t-set="key" t-value="'manguera'"/><t t-set="name" t-value="'Mangueras hidráulicas'"/>
                                    <t t-set="desc" t-value="'Llevan el aceite a presión hasta el cilindro y de regreso.'"/><t t-set="sign" t-value="'hay fugas, ampollas o se ve la malla por fuera.'"/>
                                    <t t-set="cat" t-value="cats['hidraulica']"/><t t-set="tipo" t-value="'manguera'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="2"/><t t-set="key" t-value="'conexiones'"/><t t-set="name" t-value="'Conexiones y coples rápidos'"/>
                                    <t t-set="desc" t-value="'Unen mangueras, cilindro y tractor sin que se salga el aceite.'"/><t t-set="sign" t-value="'gotean al conectar o ya no amarran bien.'"/>
                                    <t t-set="cat" t-value="cats['hidraulica']"/><t t-set="tipo" t-value="False"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="3"/><t t-set="key" t-value="'sellos'"/><t t-set="name" t-value="'Sellos del cilindro'"/>
                                    <t t-set="desc" t-value="'Retienen el aceite dentro del cilindro para que haga fuerza.'"/><t t-set="sign" t-value="'el vástago sale con aceite o el cilindro se baja solo.'"/>
                                    <t t-set="cat" t-value="cats['hidraulica']"/><t t-set="tipo" t-value="'reten'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="4"/><t t-set="key" t-value="'aceite'"/><t t-set="name" t-value="'Aceite hidráulico'"/>
                                    <t t-set="desc" t-value="'Transmite la fuerza y lubrica bomba, válvulas y cilindros.'"/><t t-set="sign" t-value="'se ve oscuro, espumoso o lechoso (con agua).'"/>
                                    <t t-set="cat" t-value="cats['lubricacion']"/><t t-set="tipo" t-value="False"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="5"/><t t-set="key" t-value="'filtro'"/><t t-set="name" t-value="'Filtro hidráulico'"/>
                                    <t t-set="desc" t-value="'Atrapa la suciedad antes de que dañe la bomba y las válvulas.'"/><t t-set="sign" t-value="'ya cumplió las horas que marca el fabricante del equipo.'"/>
                                    <t t-set="cat" t-value="cats['lubricacion']"/><t t-set="tipo" t-value="False"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="6"/><t t-set="key" t-value="'pernos'"/><t t-set="name" t-value="'Pernos y pasadores'"/>
                                    <t t-set="desc" t-value="'Sujetan los ojos del cilindro al equipo.'"/><t t-set="sign" t-value="'hay juego u holgura en los ojos del cilindro.'"/>
                                    <t t-set="cat" t-value="cats['tornilleria']"/><t t-set="tipo" t-value="'tornillo'"/></t>
                            </ol>
                        </div>

                        <p class="bbt-eq-note">Guía general: cada equipo es distinto. Si tienes duda, lleva la pieza a tu sucursal y la revisamos contigo.</p>
                        <div class="bbt-cta-box bbt-eq-cta">
                            <div>
                                <h2 class="bbt-h2">¿Ya sabes cuál <em>es tu pieza?</em></h2>
                                <p class="bbt-lead mt-2">Mídela, tómale una foto y mándala a tu sucursal.</p>
                            </div>
                            <a class="bbt-btn bbt-btn--yellow" href="/tu-pieza">Buscar mi pieza</a>
                        </div>
