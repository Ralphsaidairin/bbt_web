<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "¿Qué lleva tu equipo?" (/tu-equipo): tres equipos dibujados con sus partes numeradas.
        Cada parte enlaza a su línea del catálogo y a /tu-pieza con el tipo ya elegido.
        Los textos de las partes se editan aquí o desde el constructor; el dibujo y la parte activa
        los maneja static/src/js/babatsa_equipo.js (sin JS se ven todas las partes abiertas).
    -->

    <!-- Una parte de la lista. Recibe: n, key, name, desc, sign, cat (url), tipo (o False) -->
    <template id="tu_equipo_part" name="Babatsa: Parte de equipo">
        <li class="bbt-eq-part" t-att-data-part="key">
            <button type="button" class="bbt-eq-item" t-att-aria-controls="'bbt-eq-d-%s' % key" aria-expanded="false">
                <span class="bbt-eq-n" t-esc="n"/><span t-esc="name"/>
            </button>
            <div class="bbt-eq-detail" t-att-id="'bbt-eq-d-%s' % key">
                <p t-esc="desc"/>
                <p class="bbt-eq-sign"><b>Revísala si:</b> <t t-esc="sign"/></p>
                <div class="bbt-eq-links">
                    <a class="bbt-btn bbt-btn--blue bbt-btn--sm" t-att-href="cat">Ver en catálogo</a>
                    <a t-if="tipo" class="bbt-btn bbt-btn--ghost bbt-btn--sm" t-att-href="'/tu-pieza?tipo=%s' % tipo">Mídela y pídela</a>
                    <a t-else="" class="bbt-btn bbt-btn--ghost bbt-btn--sm" href="/tu-pieza?tipo=otra">Pídela con una foto</a>
                </div>
            </div>
        </li>
    </template>

    <!-- Punto numerado sobre el dibujo -->
    <template id="tu_equipo_hot" name="Babatsa: Punto de parte">
        <g class="bbt-eq-hot" t-att-data-part="key" t-att-transform="'translate(%s %s)' % (x, y)" tabindex="0" role="button" t-att-aria-label="'%s. %s' % (n, name)">
            <circle r="15"/>
            <text y="5" text-anchor="middle" t-esc="n"/>
        </g>
    </template>

    <template id="tu_equipo_page" name="Babatsa: Qué lleva tu equipo">
        <t t-call="website.layout">
            <t t-set="additional_title">Tu equipo</t>
            <div id="wrap">
                <section class="bbt bbt-sec bbt-jobs-hero bbt-eq-hero">
                    <div class="container">
                        <p class="bbt-eyebrow">Tu equipo</p>
                        <h1 class="bbt-h2">¿Qué lleva <em>tu equipo?</em></h1>
                        <p class="bbt-lead mt-3">Elige un equipo y toca cada parte: te decimos para qué sirve, cuándo revisarla y dónde la encuentras en Babatsa.</p>
                    </div>
                </section>

                <section class="bbt bbt-sec bbt-eq-sec">
                    <div class="container">
                        <div class="bbt-eq-tabs" role="tablist" aria-label="Equipos">
                            <button type="button" role="tab" class="bbt-eq-tab is-on" data-eq="bomba" aria-selected="true">Bomba de riego</button>
                            <button type="button" role="tab" class="bbt-eq-tab" data-eq="banda" aria-selected="false">Transmisión por banda</button>
                            <button type="button" role="tab" class="bbt-eq-tab" data-eq="hidraulico" aria-selected="false">Cilindro hidráulico</button>
                        </div>

                        <t t-call="website_babatsa.mascot_guide">
                            <t t-set="bbt_guide_text">Toca un número del dibujo y te digo para qué sirve esa parte y cuándo revisarla.</t>
                            <t t-set="bbt_guide_class" t-value="'bbt-eq-guide'"/>
                        </t>
                        <!-- ============ BOMBA DE RIEGO ============ -->
                        <div class="bbt-eq" data-eq="bomba">
                            <div class="bbt-eq-stage">
                                <p class="bbt-eq-tag">Campo · riego</p>
                                <svg class="bbt-eq-svg" viewBox="0 0 640 360" aria-hidden="true">
                                    <g data-part="tornillos"><rect x="60" y="282" width="520" height="22" rx="4" class="eq-navy"/>
                                        <g class="eq-bolt"><rect x="92" y="270" width="16" height="12" rx="2"/><rect x="232" y="270" width="16" height="12" rx="2"/><rect x="372" y="270" width="16" height="12" rx="2"/><rect x="512" y="270" width="16" height="12" rx="2"/></g></g>
                                    <!-- Motor -->
                                    <rect x="62" y="150" width="24" height="120" rx="8" class="eq-metal"/>
                                    <rect x="84" y="140" width="176" height="132" rx="14" class="eq-blue"/>
                                    <g class="eq-fins"><path d="M108 150v112M128 150v112M148 150v112M168 150v112M188 150v112M208 150v112M228 150v112"/></g>
                                    <rect x="130" y="118" width="70" height="24" rx="4" class="eq-navy"/>
                                    <g data-part="balero"><circle cx="248" cy="207" r="16" class="eq-metal"/><circle cx="248" cy="207" r="9" class="eq-yellow"/></g>
                                    <g data-part="grasa"><rect x="341" y="166" width="10" height="16" rx="2" class="eq-yellow"/><circle cx="346" cy="164" r="5" class="eq-yellow"/></g>
                                    <rect x="260" y="200" width="36" height="14" class="eq-metal"/>
                                    <g data-part="cople"><rect x="292" y="186" width="16" height="42" rx="3" class="eq-navy"/><rect x="308" y="192" width="8" height="30" class="eq-yellow"/><rect x="316" y="186" width="16" height="42" rx="3" class="eq-navy"/></g>
                                    <!-- Bomba -->
                                    <rect x="332" y="182" width="44" height="50" rx="6" class="eq-metal"/>
                                    <g data-part="sello"><rect x="372" y="194" width="10" height="26" rx="2" class="eq-rubber"/></g>
                                    <circle cx="450" cy="207" r="74" class="eq-camp"/>
                                    <circle cx="450" cy="207" r="30" class="eq-navy"/>
