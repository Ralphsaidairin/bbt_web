                                    <rect x="520" y="186" width="40" height="40" class="eq-camp"/>
                                    <rect x="556" y="180" width="14" height="52" rx="3" class="eq-metal"/>
                                    <g data-part="manguera"><path d="M570 206h20q22 0 22 24v60" class="eq-hose"/><path d="M570 206h20q22 0 22 24v60" class="eq-hose-print"/></g>
                                    <t t-foreach="[(1, 'balero', 'Baleros', 248, 170), (2, 'cople', 'Cople', 312, 160), (3, 'sello', 'Sello de la flecha', 377, 252), (4, 'manguera', 'Manguera de succión', 612, 318), (5, 'tornillos', 'Tornillos de anclaje', 100, 248), (6, 'grasa', 'Grasa', 346, 136)]" t-as="h">
                                        <t t-call="website_babatsa.tu_equipo_hot"><t t-set="n" t-value="h[0]"/><t t-set="key" t-value="h[1]"/><t t-set="name" t-value="h[2]"/><t t-set="x" t-value="h[3]"/><t t-set="y" t-value="h[4]"/></t>
                                    </t>
                                </svg>
                            </div>
                            <ol class="bbt-eq-list">
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="1"/><t t-set="key" t-value="'balero'"/><t t-set="name" t-value="'Baleros del motor y de la bomba'"/>
                                    <t t-set="desc" t-value="'Dejan girar la flecha con poca fricción.'"/><t t-set="sign" t-value="'hay zumbido, ruido metálico o la tapa del motor se calienta.'"/>
                                    <t t-set="cat" t-value="cats['rodamientos']"/><t t-set="tipo" t-value="'balero'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="2"/><t t-set="key" t-value="'cople'"/><t t-set="name" t-value="'Cople'"/>
                                    <t t-set="desc" t-value="'Une la flecha del motor con la de la bomba y absorbe la desalineación.'"/><t t-set="sign" t-value="'golpetea al arrancar o el hule (araña) está gastado.'"/>
                                    <t t-set="cat" t-value="cats['transmision']"/><t t-set="tipo" t-value="False"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="3"/><t t-set="key" t-value="'sello'"/><t t-set="name" t-value="'Sello o retén de la flecha'"/>
                                    <t t-set="desc" t-value="'Evita que el agua se salga por donde pasa la flecha.'"/><t t-set="sign" t-value="'gotea agua por la flecha.'"/>
                                    <t t-set="cat" t-value="cats['rodamientos']"/><t t-set="tipo" t-value="'reten'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="4"/><t t-set="key" t-value="'manguera'"/><t t-set="name" t-value="'Manguera de succión'"/>
                                    <t t-set="desc" t-value="'Lleva el agua del pozo o del canal hasta la bomba.'"/><t t-set="sign" t-value="'la bomba no ceba o la manguera está aplastada o agrietada.'"/>
                                    <t t-set="cat" t-value="cats['hidraulica']"/><t t-set="tipo" t-value="'manguera'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="5"/><t t-set="key" t-value="'tornillos'"/><t t-set="name" t-value="'Tornillos de anclaje'"/>
                                    <t t-set="desc" t-value="'Fijan motor y bomba a la base para que no se desalineen.'"/><t t-set="sign" t-value="'el equipo vibra o hay tornillos flojos u oxidados.'"/>
                                    <t t-set="cat" t-value="cats['tornilleria']"/><t t-set="tipo" t-value="'tornillo'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="6"/><t t-set="key" t-value="'grasa'"/><t t-set="name" t-value="'Grasa para baleros'"/>
                                    <t t-set="desc" t-value="'Protege los baleros del desgaste y del agua.'"/><t t-set="sign" t-value="'los baleros suenan secos o ya pasó el tiempo de engrase del fabricante.'"/>
                                    <t t-set="cat" t-value="cats['lubricacion']"/><t t-set="tipo" t-value="False"/></t>
                            </ol>
                        </div>

                        <!-- ============ TRANSMISIÓN POR BANDA ============ -->
                        <div class="bbt-eq" data-eq="banda">
                            <div class="bbt-eq-stage">
                                <p class="bbt-eq-tag">Industria · taller</p>
                                <svg class="bbt-eq-svg" viewBox="0 0 640 360" aria-hidden="true">
                                    <rect x="30" y="300" width="580" height="14" rx="3" class="eq-navy"/>
                                    <!-- Motor -->
                                    <rect x="40" y="196" width="150" height="100" rx="14" class="eq-blue"/>
                                    <g class="eq-fins"><path d="M62 206v80M82 206v80M102 206v80M122 206v80M142 206v80M162 206v80"/></g>
                                    <rect x="190" y="238" width="22" height="12" class="eq-metal"/>
                                    <!-- Estructura de la flecha -->
                                    <rect x="430" y="196" width="18" height="104" class="eq-navy"/>
                                    <rect x="572" y="196" width="18" height="104" class="eq-navy"/>
                                    <rect x="404" y="146" width="210" height="10" class="eq-metal"/>
                                    <g data-part="banda"><path d="M222 214L486 92A60 60 0 0 1 532 196L222 270A28 28 0 0 1 222 214Z" class="eq-belt"/></g>
                                    <g data-part="polea">
                                        <circle cx="222" cy="242" r="28" class="eq-metal"/><circle cx="222" cy="242" r="8" class="eq-navy"/>
                                        <circle cx="500" cy="151" r="60" class="eq-metal"/><circle cx="500" cy="151" r="44" class="eq-camp"/><circle cx="500" cy="151" r="12" class="eq-navy"/>
                                    </g>
                                    <g data-part="chumacera">
                                        <path d="M414 196h50v-14a25 25 0 0 0-50 0z" class="eq-yellow"/><rect x="408" y="192" width="62" height="10" rx="2" class="eq-navy"/>
                                        <path d="M556 196h50v-14a25 25 0 0 0-50 0z" class="eq-yellow"/><rect x="550" y="192" width="62" height="10" rx="2" class="eq-navy"/>
                                    </g>
                                    <g data-part="grasa"><rect x="577" y="146" width="8" height="12" rx="2" class="eq-metal"/><circle cx="581" cy="144" r="4" class="eq-metal"/></g>
                                    <g data-part="tornillos" class="eq-bolt"><rect x="412" y="186" width="10" height="8"/><rect x="456" y="186" width="10" height="8"/><rect x="554" y="186" width="10" height="8"/><rect x="598" y="186" width="10" height="8"/><rect x="60" y="290" width="12" height="10"/><rect x="160" y="290" width="12" height="10"/></g>
                                    <t t-foreach="[(1, 'banda', 'Banda', 352, 140), (2, 'polea', 'Poleas', 500, 74), (3, 'chumacera', 'Chumaceras', 439, 236), (4, 'tornillos', 'Tornillería', 116, 336), (5, 'grasa', 'Grasa', 610, 126)]" t-as="h">
                                        <t t-call="website_babatsa.tu_equipo_hot"><t t-set="n" t-value="h[0]"/><t t-set="key" t-value="h[1]"/><t t-set="name" t-value="h[2]"/><t t-set="x" t-value="h[3]"/><t t-set="y" t-value="h[4]"/></t>
                                    </t>
                                </svg>
                            </div>
                            <ol class="bbt-eq-list">
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="1"/><t t-set="key" t-value="'banda'"/><t t-set="name" t-value="'Banda'"/>
                                    <t t-set="desc" t-value="'Transmite la fuerza del motor a la polea del equipo.'"/><t t-set="sign" t-value="'chilla al arrancar, se ve brillosa o tiene grietas.'"/>
                                    <t t-set="cat" t-value="cats['transmision']"/><t t-set="tipo" t-value="'banda'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="2"/><t t-set="key" t-value="'polea'"/><t t-set="name" t-value="'Poleas'"/>
                                    <t t-set="desc" t-value="'Llevan la banda y, con su tamaño, definen la velocidad del equipo.'"/><t t-set="sign" t-value="'el canal está gastado y la banda se hunde o patina.'"/>
                                    <t t-set="cat" t-value="cats['transmision']"/><t t-set="tipo" t-value="False"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="3"/><t t-set="key" t-value="'chumacera'"/><t t-set="name" t-value="'Chumaceras'"/>
                                    <t t-set="desc" t-value="'Sostienen la flecha con un balero dentro de su caja.'"/><t t-set="sign" t-value="'hacen ruido, se calientan o la flecha tiene juego.'"/>
                                    <t t-set="cat" t-value="cats['rodamientos']"/><t t-set="tipo" t-value="'balero'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="4"/><t t-set="key" t-value="'tornillos'"/><t t-set="name" t-value="'Tornillería'"/>
                                    <t t-set="desc" t-value="'Mantiene motor y chumaceras en su lugar y la banda bien tensada.'"/><t t-set="sign" t-value="'la banda se destensa sola o hay tornillos flojos.'"/>
                                    <t t-set="cat" t-value="cats['tornilleria']"/><t t-set="tipo" t-value="'tornillo'"/></t>
                                <t t-call="website_babatsa.tu_equipo_part"><t t-set="n" t-value="5"/><t t-set="key" t-value="'grasa'"/><t t-set="name" t-value="'Grasa para chumaceras'"/>
                                    <t t-set="desc" t-value="'Se aplica por la grasera para que el balero no se seque.'"/><t t-set="sign" t-value="'la chumacera suena seca o ya pasó el tiempo de engrase.'"/>
                                    <t t-set="cat" t-value="cats['lubricacion']"/><t t-set="tipo" t-value="False"/></t>
                            </ol>
                        </div>

                        <!-- ============ CILINDRO HIDRÁULICO ============ -->
                        <div class="bbt-eq" data-eq="hidraulico">
